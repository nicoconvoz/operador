node_modules/
dist/
coverage/
*.log

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
wallet.json

# Anything that looks like a credential, blocked by pattern rather than by
# name. This repository is PUBLIC: a single `git add -A` is all that stands
# between a file left in the working tree and the whole internet, and "I will
# remember not to commit it" is not a control.
tools/acceso/
**/acceso/
pass.txt
*password*
*credential*
*.secret

# Build artefact: incremental TypeScript state, regenerated on every build.
# It was tracked, so it changed on every typecheck and blocked a stash pop
# mid-diagnosis. Nothing reads it but tsc, and tsc rebuilds it.
dashboard/tsconfig.tsbuildinfo
