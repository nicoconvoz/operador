# Operador by Open Doors — copy to .env and fill in. NEVER commit .env.

# paper is the only accepted value today: live mode refuses to start until a
# wallet adapter exists and has been reviewed.
OPERADOR_MODE=paper
OPERADOR_CHAIN=solana

# Supabase or Neon free tier
DATABASE_URL=postgres://user:password@host:5432/operador

# @BotFather creates the bot; TELEGRAM_CHAT_ID is YOUR chat — it is the only
# one the bot will obey.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

OPERADOR_CAPITAL_USD=1000
OPERADOR_MAX_POSITIONS=5
OPERADOR_GAS_USD=0.05
OPERADOR_CYCLE_MS=300000
OPERADOR_HEALTH_MS=600000

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
