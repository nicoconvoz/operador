# Operador by Open Doors — copy to .env and fill in. NEVER commit .env.

# paper is the only accepted value today: live mode refuses to start until a
# wallet adapter exists and has been reviewed.
OPERADOR_MODE=paper
OPERADOR_CHAIN=solana

# 15m or 1h. 15m is the production setting: on young tokens an hour is long
# enough for the move to be over before the strategy has an opinion.
OPERADOR_TIMEFRAME=15m

# A 15m bar closes four times an hour, so check more often than the 1H default.
OPERADOR_CYCLE_MS=180000

# Supabase or Neon free tier
DATABASE_URL=postgres://user:password@host:5432/operador

# The one credential that can change anything: it lets the Android app engage
# and release the kill switch, and nothing else — no order, no wallet, no
# position. At least 24 characters, or the control endpoint refuses to work at
# all rather than accepting something guessable.
OPERADOR_CONTROL_TOKEN=change-me-at-least-24-characters-long

# USD per ladder level. 15 makes the ladder FLAT — $15 at every level, $150
# over ten fills — which is the size chosen for 15-minute bars. Raise it as the
# capital grows. This is production's choice; the backtest's own 5,000 lives in
# DEFAULT_PARAMS and is left alone because the parity harness asserts it.
OPERADOR_MAX_USD_PER_LEVEL=15

OPERADOR_CAPITAL_USD=1000
OPERADOR_MAX_POSITIONS=5
OPERADOR_GAS_USD=0.05
OPERADOR_CYCLE_MS=300000
OPERADOR_HEALTH_MS=600000

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Only used when OPERADOR_CHAIN=bsc. Public and keyless.
BSC_RPC_URL=https://bsc-dataseed.binance.org
