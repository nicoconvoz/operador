{
  "name": "operador",
  "description": "Operador by Open Doors — CASCADE DCA executor and small-cap scanner for on-chain spot markets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist --module nodenext --moduleResolution nodenext",
    "start": "node dist/runtime/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
